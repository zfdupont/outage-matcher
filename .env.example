# Anthropic API (agent + LLM judge)
ANTHROPIC_API_KEY=your-key-here
# Embedding provider keys, only if a hosted embedding model is used
VOYAGE_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
# Postgres (pgvector); docker compose reads the POSTGRES_* values
POSTGRES_USER=outage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outage
POSTGRES_PORT=5432
# Host port for the API container (docker compose up serves http://localhost:$API_PORT)
API_PORT=8000
DATABASE_URL=postgresql://outage:change-me@localhost:5432/outage
# Langfuse tracing
LANGFUSE_PUBLIC_KEY=your-key-here
LANGFUSE_SECRET_KEY=your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com
